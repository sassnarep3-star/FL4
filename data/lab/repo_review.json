 "findings": [
  {
   "id": "RV-1",
   "area": "structure",
   "finding": "Three overlapping site sections now exist in one repository: the root dashboard (index.html + pages/), the signals/ section (14 pages), and this lab/ section (16 pages). All three are published from the repository root by one Pages workflow.",
   "evidence": "index.html, signals/index.html, lab/index.html",
   "assessment": "Not an error, but it is a duplication risk: three sections now carry their own questions, suggestions, flagged and sources pages with different ID namespaces.",
   "recommended": "Keep the namespaces distinct (root F-*, signals F-*, lab L-F-*) and cross-link, which this section does. A future integration pass should merge the three question registers into one.",
   "link": "https://github.com/sassnarep3-star/FL4/blob/main/index.html"
  },
  {
   "id": "RV-2",
   "area": "data",
   "finding": "Two prior independent captures of the same official Week 10 injury report exist: data/injuries_w10_2026.json and data/signals/injuries_week10_2026.json. This session adds a third, data/lab/injuries_week10_2026.json, with 347 rows, 28 clubs, 171 rows carrying a game status and 81 Out or Doubtful.",
   "evidence": "data/injuries_w10_2026.json, data/signals/injuries_week10_2026.json, data/lab/injuries_week10_2026.json",
   "assessment": "The counts differ because the official page is a live document and the captures were taken on different days, and because the three captures apply different inclusion rules. None of the three is wrong; they are not comparable without stating the rule.",
   "recommended": "Do not merge the row sets. Pick one inclusion rule, record it as code, and re-run it over every retained snapshot. Flagged as L-F-01 and L-F-16.",
   "link": "https://github.com/sassnarep3-star/FL4/blob/main/data/injuries_w10_2026.json"
  },
  {
   "id": "RV-3",
   "area": "publication",
   "finding": "GitHub Pages publishes the repository root, so raw capture data sits in the published tree.",
   "evidence": ".github/workflows/pages.yml",
   "assessment": "This is a real boundary problem, not a theoretical one: any raw row committed to the repository is publicly served.",
   "recommended": "Move raw captures out of the published tree (SG-06). Flagged as L-F-04.",
   "link": "https://github.com/sassnarep3-star/FL4/blob/main/.github/workflows/pages.yml"
  },
  {
   "id": "RV-4",
   "area": "verification",
   "finding": "The existing root builder enforces a source link per verified row and fails on a column key no row carries.",
   "evidence": "tools/build_site.py, tools/validate.py",
   "assessment": "Good practice that this section copies deliberately.",
   "recommended": "Reuse the pattern, not the file - this section ships its own builder so the two sections cannot break each other.",
   "link": "https://github.com/sassnarep3-star/FL4/blob/main/tools/build_site.py"
  },
  {
   "id": "RV-5",
   "area": "governance",
   "finding": "COORDINATION.md now carries three generations of task board, including boards from merged branches.",
   "evidence": "COORDINATION.md",
   "assessment": "Correct behaviour per the session rules - history is preserved rather than rewritten - but the file is now large enough that the active board needs to be at the top.",
   "recommended": "This session placed its board at the top and pushed the previous boards below a divider.",
   "link": "https://github.com/sassnarep3-star/FL4/blob/main/COORDINATION.md"
  },
  {
   "id": "RV-6",
   "area": "legal",
   "finding": "No automated league capture is configured anywhere in the repository, and NFL.com Terms section 1.3 prohibits systematic retrieval absent express prior written consent.",
   "evidence": ".github/workflows/, NFL.com Terms 1.3",
   "assessment": "Consistent. Several requirements on the brief ask for daily or weekly scheduled capture of league pages; none can be implemented lawfully until the terms question is answered.",
   "recommended": "Answer Q-PRICE-02 and Q-SNAPSHOT-01 before building any runner. Flagged as L-F-17.",
   "link": "https://github.com/sassnarep3-star/FL4/blob/main/.github/workflows/verify.yml"
  },
  {
   "id": "RV-7",
   "area": "data",
   "finding": "No price, odds, line or closing number exists anywhere in the repository across all three sections.",
   "evidence": "data/, data/signals/, data/lab/",
   "assessment": "Correct and consistent. Three independent sessions have now reached the same conclusion, which is the strongest evidence that the gap is environmental rather than a missed file.",
   "recommended": "Treat Q-PRICE-01 as the single gate behind most of the brief.",
   "link": "https://github.com/sassnarep3-star/FL4/blob/main/data/"
  },
  {
   "id": "RV-9",
   "area": "governance",
   "finding": "main now carries prereg/REGISTRATION.md (registration 2026-11-16), which freezes the signals section's strategies, gates, leaderboard and correlation protocol with SHA-256 checks on every build, plus data/readiness.json (31 rows) as a readiness register.",
   "evidence": "prereg/REGISTRATION.md, prereg/registration.json, data/readiness.json",
   "assessment": "The repository now holds two versions of the same governance text: the frozen registration on main and this section's restatement. Both are internally consistent, but a reader cannot tell which one binds.",
   "recommended": "This section defers to the frozen registration in its leaderboard page and flags the duplication (L-F-19). An integration pass should point the lab pages at prereg/ rather than restating it.",
   "link": "https://github.com/sassnarep3-star/FL4/blob/main/prereg/REGISTRATION.md"
  },
  {
   "id": "RV-10",
   "area": "publication",
   "finding": "The lab section is published but is not linked from the root landing page, because root index.html and tools/build_site.py are owned by other sessions and main moved through PRs #13-#17 during this session.",
   "evidence": "index.html, lab/index.html",
   "assessment": "The section is reachable only by URL. That is a discoverability defect, not a build defect.",
   "recommended": "Add one nav entry and one tile on the root landing page in the integration pass. Recorded as L-F-18.",
   "link": "https://github.com/sassnarep3-star/FL4/blob/main/index.html"
  }
 ]
